#!/bin/sh
# 95-net4sats-feed — Register net4sats package feed
# Runs once on first boot after package install
# Idempotent: safe to run multiple times

# SUPERSEDED: the old origin is NXDOMAIN and is not revived. See README.md.
FEED_URL=""
FEED_LINE="$FEED_URL/net4sats"

if [ -f /etc/apk/repositories ]; then
  # apk-based (OpenWrt 25.12+)
  grep -qF "$FEED_LINE" /etc/apk/repositories 2>/dev/null && exit 0
  echo "$FEED_LINE" >> /etc/apk/repositories
elif [ -f /etc/opkg/customfeeds.conf ]; then
  # opkg-based (OpenWrt 24.10)
  grep -qF "$FEED_URL" /etc/opkg/customfeeds.conf 2>/dev/null && exit 0
  echo "src/gz net4sats $FEED_URL" >> /etc/opkg/customfeeds.conf
fi

exit 0
