#!/bin/sh
# 97-net4sats-nodogsplash — Add net4sats admin ports to nodogsplash allowed list
# Runs once on first boot. Idempotent.

# Check if nodogsplash is configured
uci -q get nodogsplash.@nodogsplash[0] >/dev/null 2>&1 || exit 0

# Port 8090 (admin UI) must be reachable through the captive portal
NEEDS_8090=$(uci -q get nodogsplash.@nodogsplash[0].users_to_router | grep -c "8090" 2>/dev/null || echo 0)
if [ "$NEEDS_8090" -eq 0 ]; then
  uci add_list nodogsplash.@nodogsplash[0].users_to_router='tcp:8090'
fi

# Port 443 (HTTPS) must also pass through
NEEDS_443=$(uci -q get nodogsplash.@nodogsplash[0].users_to_router | grep -c "443" 2>/dev/null || echo 0)
if [ "$NEEDS_443" -eq 0 ]; then
  uci add_list nodogsplash.@nodogsplash[0].users_to_router='tcp:443'
fi

# Port 2051 (captive portal SPA) must be reachable through NDS
NEEDS_2051=$(uci -q get nodogsplash.@nodogsplash[0].users_to_router | grep -c "2051" 2>/dev/null || echo 0)
if [ "$NEEDS_2051" -eq 0 ]; then
  uci add_list nodogsplash.@nodogsplash[0].users_to_router='allow tcp port 2051'
fi

uci commit nodogsplash

exit 0
